@page "{id:int}"
@model LibraryManagementSystem.Web.Pages.Users.EditModel

@section Styles {
    <link rel="stylesheet" href="~/css/books.css" />
}

<div class="form-page">

    <div class="page-header">

        <div>
            <h1>Edit User</h1>
            <p>Update the user account information.</p>
        </div>

        <a asp-page="Details"
           asp-route-id="@Model.UserID"
           class="secondary-btn">
            ← Back to Details
        </a>

    </div>

    <div class="form-card">

        <div class="form-header">
            <h1>User Information</h1>
            <p>Update the account details.</p>
        </div>

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-group">
                <label>User ID</label>

                <input value="@Model.UserID"
                       class="custom-input"
                       readonly />
            </div>

            <div class="form-group">
                <label asp-for="User.Name">Name</label>

                <input asp-for="User.Name"
                       class="custom-input" />

                <span asp-validation-for="User.Name"
                      class="validation-message">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="User.Email">Email</label>

                <input asp-for="User.Email"
                       class="custom-input" />

                <span asp-validation-for="User.Email"
                      class="validation-message">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="User.RoleID">Role</label>

                <select asp-for="User.RoleID"
                        class="custom-input">

                    <option value="1">Admin</option>
                    <option value="2">Member</option>
                    <option value="3">Librarian</option>

                </select>
            </div>

            <div class="form-group">
                <label asp-for="User.PhoneNumber">
                    Phone Number
                </label>

                <input asp-for="User.PhoneNumber"
                       class="custom-input" />
            </div>

            <div class="form-group">
                <label>
                    <input asp-for="User.IsActive" />
                    Active
                </label>
            </div>

           

            <div class="form-actions">

                <a asp-page="Details"
                   asp-route-id="@Model.UserID"
                   class="secondary-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="primary-action-btn">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}