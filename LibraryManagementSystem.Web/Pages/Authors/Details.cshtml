@page
@model LibraryManagementSystem.Web.Pages.Authors.DetailsModel

<div class="details-page">

    @if (TempData["DeleteError"] != null)
    {
        <div class="validation-summary">
            @TempData["DeleteError"]
        </div>
    }
    <div class="details-card">

        <div class="details-header">

            <div>

                <span class="details-label">
                    AUTHOR DETAILS
                </span>

                <h1>
                    @Model.Author!.Name
                </h1>

                <p>
                    @(Model.Author.Email ?? "No email provided")
                </p>

            </div>

        </div>

        <div class="details-body">

            <div class="detail-item">
                <span>Author ID</span>
                <strong>@Model.Author.AuthorID</strong>
            </div>

            <div class="detail-item">
                <span>Name</span>
                <strong>@Model.Author.Name</strong>
            </div>

            <div class="detail-item">
                <span>Email</span>
                <strong>
                    @(Model.Author.Email ?? "Not specified")
                </strong>
            </div>

            <div class="detail-item">
                <span>Nationality</span>
                <strong>
                    @(Model.Author.Nationality ?? "Not specified")
                </strong>
            </div>

        </div>

        <div class="details-footer">

            <a asp-page="Index"
               class="secondary-btn">
                Back to Authors
            </a>

            <a asp-page="Edit"
               asp-route-id="@Model.Author.AuthorID"
               class="primary-action-btn">
                Edit Author
            </a>

            <form method="post"
                  asp-page-handler="Delete"
                  asp-route-id="@Model.Author.AuthorID"
                  onsubmit="return confirm('Are you sure you want to delete this author?');">

                <button type="submit"
                        class="delete-btn">
                    Delete Author
                </button>

            </form>

        </div>

    </div>

</div>