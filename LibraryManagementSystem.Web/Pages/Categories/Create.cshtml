@page
@model LibraryManagementSystem.Web.Pages.Categories.CreateModel

@{
    ViewData["Title"] = "Create Category";
}

<link rel="stylesheet" href="~/css/books.css" />

<div class="form-page">

    <div class="form-card">

        <div class="form-header">
            <h1>Create Category</h1>
            <p>Add a new book category.</p>
        </div>

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-group">
                <label asp-for="Category.Name"></label>

                <input asp-for="Category.Name"
                       class="custom-input"
                       placeholder="Enter category name" />

                <span asp-validation-for="Category.Name"
                      class="validation-message">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Category.Description"></label>

                <textarea asp-for="Category.Description"
                          class="custom-input"
                          rows="5"
                          placeholder="Enter category description (optional)">
                </textarea>

                <span asp-validation-for="Category.Description"
                      class="validation-message">
                </span>
            </div>

            <div class="form-actions">

                <button type="submit"
                        class="primary-action-btn">
                    Create Category
                </button>

                <a asp-page="Index"
                   class="secondary-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}