@page
@model LibraryManagementSystem.Web.Pages.Categories.DetailsModel

@{
    ViewData["Title"] = "Category Details";
}

<link rel="stylesheet" href="~/css/books.css" />

<div class="details-page">

    <div class="details-card">

        <div class="details-header">
            <div>
                <p>Category Details</p>
                <h1>@Model.Category?.Name</h1>
            </div>

            <span class="entity-id">
                ID: @Model.Category?.CategoryID
            </span>
        </div>

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>

        <div class="details-body">

            <div class="detail-item">
                <span class="details-label">Category ID</span>
                <span>@Model.Category?.CategoryID</span>
            </div>

            <div class="detail-item">
                <span class="details-label">Name</span>
                <span>@Model.Category?.Name</span>
            </div>

            <div class="detail-item">
                <span class="details-label">Description</span>
                <span>
                    @(string.IsNullOrWhiteSpace(Model.Category?.Description)
                                        ? "No description"
                                        : Model.Category.Description)
                </span>
            </div>

        </div>

        <div class="details-footer">

            <a asp-page="Edit"
               asp-route-id="@Model.Category?.CategoryID"
               class="edit-btn">
                Edit
            </a>

            <form method="post"
                  asp-page-handler="Delete"
                  asp-route-id="@Model.Category?.CategoryID"
                  onsubmit="return confirm('Are you sure you want to delete this category?');"
                  style="display:inline;">
                <button type="submit"
                        class="delete-btn">
                    Delete
                </button>
            </form>

            <a asp-page="Index"
               class="secondary-btn">
                Back
            </a>

        </div>

    </div>

    @if (Model.Books.Any())
    {
        <div class="details-card" style="margin-top: 24px;">

            <div class="details-header">
                <div>
                    <p>Books</p>
                    <h1>Books in this Category</h1>
                </div>
            </div>

            <div class="details-body">

                @foreach (var book in Model.Books)
                {
                    <div class="detail-item">
                        <span class="details-label">
                            @book.BookID
                        </span>

                        <span>
                            @book.Title
                        </span>
                    </div>
                }

            </div>

        </div>
    }
    else
    {
        <div class="empty-state" style="margin-top: 24px;">
            <h3>No books</h3>
            <p>This category has no books assigned to it.</p>
        </div>
    }

</div>