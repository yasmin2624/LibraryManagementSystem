@page
@model LibraryManagementSystem.Web.Pages.Books.DetailsModel

@section Styles {
    <link rel="stylesheet" href="~/css/books.css" />
}

<div class="details-page">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values
                    .SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <div class="details-card">

        <div class="details-header">

            <div>
                <span class="details-label">
                    BOOK DETAILS
                </span>

                <h1>@Model.Book!.Title</h1>

                <p>
                    ISBN: @Model.Book.ISBN
                </p>
            </div>

            @if (Model.Book.Availability)
            {
                <span class="status available">
                    Available
                </span>
            }
            else
            {
                <span class="status borrowed">
                    Borrowed
                </span>
            }

        </div>

        <div class="details-body">

            <div class="detail-item">
                <span>Book ID</span>
                <strong>@Model.Book.BookID</strong>
            </div>

            <div class="detail-item">
                <span>ISBN</span>
                <strong>@Model.Book.ISBN</strong>
            </div>

            <div class="detail-item">
                <span>Title</span>
                <strong>@Model.Book.Title</strong>
            </div>

            <div class="detail-item">
                <span>Genre</span>
                <strong>
                    @(Model.Book.Genre ?? "Not specified")
                </strong>
            </div>

            <div class="detail-item">
                <span>Language</span>
                <strong>
                    @(Model.Book.Language ?? "Not specified")
                </strong>
            </div>

            <div class="detail-item">
                <span>Author ID</span>
                <strong>@Model.Book.AuthorID</strong>
            </div>

            <div class="detail-item">
                <span>Category ID</span>
                <strong>@Model.Book.CategoryID</strong>
            </div>

            <div class="detail-item">
                <span>Availability</span>

                <strong>
                    @(Model.Book.Availability
                                        ? "Available for borrowing"
                                        : "Currently borrowed")
                </strong>
            </div>

        </div>

        <div class="details-footer">

            <a asp-page="Index"
               class="secondary-btn">
                Back to Books
            </a>

            <a asp-page="Edit"
               asp-route-id="@Model.Book.BookID"
               class="primary-action-btn">
                Edit Book
            </a>

            <form method="post"
                  asp-page-handler="Delete"
                  asp-route-id="@Model.Book.BookID"
                  onsubmit="return confirm('Are you sure you want to delete this book?');">

                <button type="submit"
                        class="delete-btn">
                    Delete Book
                </button>

            </form>

        </div>

    </div>

</div>