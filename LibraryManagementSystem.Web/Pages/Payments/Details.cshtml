@page
@model LibraryManagementSystem.Web.Pages.Payments.DetailsModel

@{
    ViewData["Title"] = "Payment Details";
}

<link rel="stylesheet" href="~/css/books.css" />

<div class="details-page">

    <div class="details-card">

        <div class="details-header">

            <div>
                <p>Payment Details</p>
                <h1>Payment #@Model.Payment?.PaymentID</h1>
            </div>

            <span class="entity-id">
                Borrow ID: @Model.Payment?.BorrowID
            </span>

        </div>

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>

        <div class="details-body">

            <div class="detail-item">
                <span class="details-label">Payment ID</span>
                <span>@Model.Payment?.PaymentID</span>
            </div>

            <div class="detail-item">
                <span class="details-label">Borrow ID</span>
                <span>@Model.Payment?.BorrowID</span>
            </div>

            <div class="detail-item">
                <span class="details-label">Amount</span>
                <span>
                    @Model.Payment?.Amount.ToString("0.00")
                </span>
            </div>

            <div class="detail-item">
                <span class="details-label">Payment Method</span>
                <span>
                    @(string.IsNullOrWhiteSpace(Model.Payment?.PaymentMethod)
                                        ? "Not specified"
                                        : Model.Payment.PaymentMethod)
                </span>
            </div>

            <div class="detail-item">
                <span class="details-label">Payment Date</span>
                <span>
                    @Model.Payment?.PaymentDate.ToString("dd/MM/yyyy HH:mm")
                </span>
            </div>

            <div class="detail-item">
                <span class="details-label">Status</span>
                <span>
                    @(string.IsNullOrWhiteSpace(Model.Payment?.Status)
                                        ? "Not specified"
                                        : Model.Payment.Status)
                </span>
            </div>

            <div class="detail-item">
                <span class="details-label">Notes</span>
                <span>
                    @(string.IsNullOrWhiteSpace(Model.Payment?.Notes)
                                        ? "No notes"
                                        : Model.Payment.Notes)
                </span>
            </div>

        </div>

        <div class="details-footer">

            <a asp-page="Edit"
               asp-route-id="@Model.Payment?.PaymentID"
               class="edit-btn">
                Edit
            </a>

            <form method="post"
                  asp-page-handler="Delete"
                  asp-route-id="@Model.Payment?.PaymentID"
                  onsubmit="return confirm('Are you sure you want to delete this payment?');"
                  style="display:inline;">

                <button type="submit"
                        class="delete-btn">
                    Delete
                </button>

            </form>

            <a asp-page="Index"
               class="secondary-btn">
                Back
            </a>

        </div>

    </div>

</div>