@page
@model LibraryManagementSystem.Web.Pages.Payments.IndexModel

@{
    ViewData["Title"] = "Payments";
}

<link rel="stylesheet" href="~/css/books.css" />

<div class="page-header">
    <div>
        <h1>Payments</h1>
        <p>Manage payment records linked to borrow records.</p>
    </div>

    <a asp-page="Create" class="primary-btn">
        + Record Payment
    </a>
</div>

<div class="books-filters">
    <form method="get" class="filters-form">

        <div class="filter-group">
            <label for="BorrowID">Borrow ID</label>

            <input type="number"
                   id="BorrowID"
                   name="BorrowID"
                   value="@Model.BorrowID"
                   min="1"
                   placeholder="Enter Borrow ID..." />
        </div>

        <div class="filter-group">
            <label for="Status">Status</label>

            <select id="Status" name="Status">
                <option value="">All Statuses</option>

                @if (Model.Status == "Paid")
                {
                    <option value="Paid" selected>Paid</option>
                }
                else
                {
                    <option value="Paid">Paid</option>
                }

                @if (Model.Status == "Pending")
                {
                    <option value="Pending" selected>Pending</option>
                }
                else
                {
                    <option value="Pending">Pending</option>
                }

                @if (Model.Status == "Failed")
                {
                    <option value="Failed" selected>Failed</option>
                }
                else
                {
                    <option value="Failed">Failed</option>
                }
            </select>
        </div>

        <div class="filter-actions">
            <button type="submit" class="primary-btn">
                Search
            </button>

            <a asp-page="Index" class="secondary-btn">
                Clear
            </a>
        </div>

    </form>
</div>

@if (Model.Payments.Any())
{
    <div class="entity-grid">

        @foreach (var payment in Model.Payments)
        {
            <div class="entity-card">

                <div class="entity-card-header">
                    <span class="entity-id">
                        Payment ID: @payment.PaymentID
                    </span>

                    <span class="entity-id">
                        Borrow ID: @payment.BorrowID
                    </span>
                </div>

                <div class="entity-card-body">

                    <div class="entity-info">
                        <span class="info-label">Amount</span>
                        <strong>@payment.Amount.ToString("0.00")</strong>
                    </div>

                    <div class="entity-info">
                        <span class="info-label">Payment Method</span>
                        <span>
                            @(string.IsNullOrWhiteSpace(payment.PaymentMethod)
                                                ? "Not specified"
                                                : payment.PaymentMethod)
                                                                    </span>
                                                                </div>

                    <div class="entity-info">
                        <span class="info-label">Payment Date</span>
                        <span>
                            @payment.PaymentDate.ToString("dd/MM/yyyy")
                        </span>
                    </div>

                    <div class="entity-info">
                        <span class="info-label">Status</span>
                        <span>
                            @(string.IsNullOrWhiteSpace(payment.Status)
                                                ? "Not specified"
                                                : payment.Status)
                </span>
            </div>

                </div>

                <div class="entity-card-footer">

                    <a asp-page="Details"
                       asp-route-id="@payment.PaymentID"
                       class="details-btn">
                        Details
                    </a>

                    <a asp-page="Edit"
                       asp-route-id="@payment.PaymentID"
                       class="edit-btn">
                        Edit
                    </a>

                </div>

            </div>
        }

    </div>
}
else
{
    <div class="empty-state">
        <h3>No payments found</h3>
        <p>No payment records match your filters.</p>
    </div>
}