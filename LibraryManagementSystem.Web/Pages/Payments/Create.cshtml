@page
@model LibraryManagementSystem.Web.Pages.Payments.CreateModel

@section Styles {
    <link rel="stylesheet" href="~/css/books.css" />
}

<div class="form-page">

    <div class="page-header">
        <div>
            <h1>New Payment</h1>
            <p>Record a payment for a borrowing record.</p>
        </div>

        <a asp-page="Index" class="secondary-btn">
            ← Back to Payments
        </a>
    </div>

    <div class="form-card">

        <div class="form-header">
            <h1>Payment Information</h1>
            <p>Enter the details of the payment.</p>
        </div>

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            @if (Model.Payment.BorrowID > 0)
            {
                var selectedBorrow = Model.Borrows
                .FirstOrDefault(b => b.BorrowID == Model.Payment.BorrowID);

                <div class="form-group">
                    <label>Borrow</label>

                    <input type="hidden"
                           asp-for="Payment.BorrowID" />

                    <input type="text"
                           class="custom-input"
                           value="Borrow #@selectedBorrow?.BorrowID - Book ID: @selectedBorrow?.BookID - Member ID: @selectedBorrow?.MemberID - Status: @selectedBorrow?.Status"
                           readonly />
                </div>
            }
            else
            {
                <div class="form-group">
                    <label asp-for="Payment.BorrowID">Borrow</label>

                    <select asp-for="Payment.BorrowID"
                            class="custom-input">

                        <option value="0">
                            Select a borrowing record...
                        </option>

                        @foreach (var borrow in Model.Borrows)
                        {
                            <option value="@borrow.BorrowID">
                                Borrow #@borrow.BorrowID
                                - Book ID: @borrow.BookID
                                - Member ID: @borrow.MemberID
                                - Status: @borrow.Status
                            </option>
                        }

                    </select>

                    <span asp-validation-for="Payment.BorrowID"
                          class="validation-message">
                    </span>
                </div>
            }

            <div class="form-group">
                <label asp-for="Payment.Amount">Amount</label>

                <input asp-for="Payment.Amount"
                       type="number"
                       step="0.01"
                       min="0.01"
                       class="custom-input"
                       placeholder="Enter payment amount" />

                <span asp-validation-for="Payment.Amount"
                      class="validation-message">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Payment.PaymentMethod">
                    Payment Method
                </label>

                <select asp-for="Payment.PaymentMethod"
                        class="custom-input">

                    <option value="">
                        Select payment method...
                    </option>

                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="Online">Online</option>

                </select>

                <span asp-validation-for="Payment.PaymentMethod"
                      class="validation-message">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Payment.PaymentDate">
                    Payment Date
                </label>

                <input asp-for="Payment.PaymentDate"
                       type="datetime-local"
                       class="custom-input" />

                <span asp-validation-for="Payment.PaymentDate"
                      class="validation-message">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Payment.Status">Status</label>

                <select asp-for="Payment.Status"
                        class="custom-input">

                    <option value="">
                        Select status...
                    </option>

                    <option value="Paid">Paid</option>
                    <option value="Pending">Pending</option>
                    <option value="Failed">Failed</option>

                </select>

                <span asp-validation-for="Payment.Status"
                      class="validation-message">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Payment.Notes">Notes</label>

                <textarea asp-for="Payment.Notes"
                          class="custom-input"
                          rows="4"
                          placeholder="Optional notes"></textarea>

                <span asp-validation-for="Payment.Notes"
                      class="validation-message">
                </span>
            </div>

            <div class="form-actions">

                <a asp-page="Index"
                   class="secondary-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="primary-action-btn">
                    Record Payment
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}